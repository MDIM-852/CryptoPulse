# ==============================================================================
# CryptoPulse Environment Configuration (.env.local)
# ==============================================================================

# 1. Supabase Configuration (Free Tier: https://supabase.com)
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 2. Server-Side AES-256-GCM Encryption Key (Required for exchange API keys)
# Must be at least 32 characters long in production (e.g. generate via `openssl rand -hex 32`)
ENCRYPTION_SECRET=development-encryption-secret-key-must-be-32-chars-min!

# 3. Market Data & AI Explanations (100% Free Tiers)
# CoinGecko Demo API Key (Optional, leave blank for free rate-limited public endpoints)
COINGECKO_API_KEY=

# Google Gemini API Key (Free tier for "Explain the Move" AI market analysis)
# Obtain free from: https://aistudio.google.com/
GEMINI_API_KEY=

# 4. App URL (for OAuth callbacks, email confirmations, and privacy share links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
